# Database Connection String (Supabase / PostgreSQL)
# Example for Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/liferpg?schema=public"

# Authentication Secrets
JWT_SECRET="liferpg_development_secret_key_minimum_32_chars_123456789"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Seed Demo flag (true to enable mock repository fallback when DATABASE_URL is not connected)
DEMO_STORAGE_FALLBACK="true"
