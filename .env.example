# Supabase Database Connection String (Transaction Pooler port 6543 recommended for Vercel)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth Configuration (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# Optional: Service role key for admin auto-confirm email in server-side registration
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Authentication JWT Secret
JWT_SECRET="liferpg_development_secret_key_minimum_32_chars_123456789"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Mock Store Fallback (set to false in production with Supabase)
DEMO_STORAGE_FALLBACK="false"
